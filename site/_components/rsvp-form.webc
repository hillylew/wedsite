<template webc:type="11ty" 11ty:type="liquid" webc:if="invites">
  <script webc:keep>
    function filterInvites() {
      return {
        step: 1,
        guests: [],
        searchStarted: false,
        selectedInvite: null,
        inviteList: `{{ invites | json }}`,
        search: {
          fname: "",
          lname: "",
        },

        init() {
          this.inviteList = JSON.parse(this.inviteList);
        },

        startSearch() {
          this.searchStarted = true;
          this.performSelection();
        },

        performSelection() {
          const matches = this.filteredInvites;
          if (matches.length === 1) {
            this.selectedInvite = matches[0];
            this.setupGuests();
            this.step = 2;
          } else {
            this.selectedInvite = null;
          }
        },

        selectInvite(invite) {
          this.selectedInvite = invite;
          this.setupGuests();
          this.step = 2;
        },

        setupGuests() {
          if (!this.selectedInvite) return;

          const inviteGuests = this.selectedInvite.guests || [];
          this.guests = inviteGuests.map((g) => ({
            fname: g.fname || "",
            lname: g.lname || "",
            attending: null,
            dinner: "",
            allergies: "",
          }));

          if (this.selectedInvite.plusone && this.guests.length < 2) {
            this.guests.push({
              fname: "Guest",
              lname: "",
              attending: null,
              dinner: "",
              allergies: "",
              isPlusOne: true,
            });
          }
        },

        get filteredInvites() {
          if (!this.searchStarted) return [];

          const firstName = (this.search.fname || "").trim().toLowerCase();
          const lastName = (this.search.lname || "").trim().toLowerCase();

          if (!firstName || !lastName) {
            return [];
          }

          return this.inviteList.filter((invite) => {
            return invite.guests.some((guest) => {
              const guestFirstName = (guest.fname || "").trim().toLowerCase();
              const guestLastName = (guest.lname || "").trim().toLowerCase();
              return (
                guestFirstName.includes(firstName) &&
                guestLastName.includes(lastName)
              );
            });
          });
        },

        get totalSteps() {
          let steps = 1; // Search step
          if (this.guests.length === 0) return 2; // Search + Notes
          
          // We use a virtual total based on potential pages to keep the 
          // template indices (2 + index*2) consistent.
          steps = 1 + (this.guests.length * 2) + 1;
          return steps;
        },

        nextStep() {
          if (!this.selectedInvite) {
            alert("Please find your invitation first.");
            return;
          }

          if (this.step === 1) {
            this.step = 2;
            return;
          }

          const currentGuestIndex = Math.floor((this.step - 2) / 2);
          const isAttendanceStep = (this.step - 2) % 2 === 0;
          const guest = this.guests[currentGuestIndex];

          if (isAttendanceStep) {
            if (!guest || guest.attending === null) {
              alert("Please select whether you can attend.");
              return;
            }
            if (guest.attending === false || guest.attending === "false") {
              this.step += 2;
            } else {
              this.step++;
              return;
            }
          } else {
            if (!guest || !guest.dinner){
              alert("Please select a dinner choice.");
              return;
            }
            this.step++;
          }

          // Important: only skip if we are currently on a details step and that guest is NOT attending
          // The loop is for multiple consecutive declines.
          while (this.step < this.totalSteps) {
            const isDetailsStep = (this.step - 2) % 2 === 1;
            if (isDetailsStep && currentGuestIndex < this.guests.length && (guest.attending === false || guest.attending === "false")) {
              this.step++;
            } else {
              break;
            }
          }

          if (this.step > this.totalSteps) {
            this.step = this.totalSteps;
          }
        },

        prevStep() {
          if (this.step === 1) return;
          
          let targetStep = this.step - 1;
          
          while (targetStep > 1) {
            const guestIndex = Math.floor((targetStep - 2) / 2);
            const isDetailsStep = (targetStep - 2) % 2 === 1;
            
            if (guestIndex >= 0 && guestIndex < this.guests.length && isDetailsStep && (this.guests[guestIndex].attending === false || this.guests[guestIndex].attending === "false")) {
              targetStep--;
            } else {
              break;
            }
          }
          
          this.step = Math.max(1, targetStep);
        },
      };
    }
  </script>
</template>

<section class="~py-6/12 first-of-type:~pt-12/24" x-data="filterInvites()">
  <div
    class="container flex justify-between ~gap-8/16"
    :class="alignment == 'right' ? 'flex-col-reverse md:flex-row-reverse' : 'flex-col md:flex-row'"
  >
    <div
      webc:if="image"
      class="md:w-1/2"
      x-data="{ visible: false }"
      x-intersect.threshold.25.once="visible = true"
    >
      <img :src="imageHelper(image.image, 640)" :alt="alt" />
    </div>
    <div
      :class="image ? 'md:w-2/3' : ''"
      x-data="{ visible: false }"
      x-intersect.threshold.25.once="visible = true"
    >
      <div class="progress-bar border border-gray-600 rounded-full flex mb-8">
        <template x-for="s in totalSteps" :key="s">
          <div
            x-bind:class="{ 'bg-twilight rounded-r-full': s === step, 'bg-twilight': s < step, 'rounded-l-full': s === 1 }"
            class="flex-1 h-6"
          >
            <span class="sr-only" x-text="'Step ' + s"> </span>
          </div>
        </template>
      </div>
      <form
        action="/rsvp-submit"
        class="form-contents"
        method="post"
        novalidate=""
      >
        <fieldset
          class="form-item fields name"
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === 1"
        >
          <legend>look up your invitation:</legend>
          <div class="field first-name">
            <label for="guest1fname"> First Name </label>
            <input
              id="guest1fname"
              name="guest1fname"
              x-model="search.fname"
              type="text"
              value=""
            />
          </div>
          <div class="field last-name">
            <label for="guest1lname"> Last Name </label
            ><input
              id="guest1lname"
              name="guest1lname"
              x-model="search.lname"
              type="text"
              value=""
            />
          </div>
          <button
            type="button"
            class="button"
            x-on:click.prevent="startSearch()"
            x-show="!searchStarted && selectedInvite === null"
          >
            Find Invitation
          </button>
          <div x-show="searchStarted && filteredInvites.length === 1">
            <p x-show="guests.length > 1">
              Welcome! If your invitation includes a guest or your family, you
              will be able to respond for your entire group.
            </p>
            <p x-show="guests.length <= 1">
              Welcome! We were able to locate your invitation.
            </p>
          </div>
          <div x-show="searchStarted && filteredInvites.length > 1">
            <p class="mb-4">
              Multiple invitations found. Please select your family:
            </p>
            <div class="form-radio-group flex flex-col items-start">
              <template x-for="(invite, index) in filteredInvites" :key="index">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input
                    type="radio"
                    name="selectedInvite"
                    x-model="selectedInvite"
                    :value="invite"
                    x-on:change="selectInvite(invite)"
                  />
                  <span x-text="invite.family"></span>
                </label>
              </template>
            </div>
          </div>
          <div x-show="searchStarted && !filteredInvites.length">
            <p>
              No matching invites found. Please enter your name exactly as it
              appears on your invitation.
            </p>
          </div>
        </fieldset>

        <template x-if="selectedInvite !== null">
          <div>
            <template x-for="(guest, index) in guests" :key="index">
              <div>
                <div
                  class="form-item field radio required"
                  x-cloak
                  x-transition:enter="transition ease-out duration-300"
                  x-transition:enter-start="opacity-0 scale-90"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-show="step === (2 + index * 2)"
                >
                  <label x-bind:for="'guest_' + index + '_attending'">
                    Will <span x-text="guest.fname + ' ' + guest.lname"></span> be
                    able to attend?
                  </label>
                  <div class="form-radio-group">
                    <label>
                      <input
                        type="radio"
                        x-bind:name="'guest_' + index + '_attending'"
                        x-model="guest.attending"
                        x-bind:value="true"
                      />
                      Joyfully Accepts
                    </label>
                    <label>
                      <input
                        type="radio"
                        x-bind:name="'guest_' + index + '_attending'"
                        x-model="guest.attending"
                        x-bind:value="false"
                      />
                      Sadly Declines
                    </label>
                  </div>
                </div>
    
                <div
                  class="form-item field select required"
                  x-cloak
                  x-transition:enter="transition ease-out duration-300"
                  x-transition:enter-start="opacity-0 scale-90"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-show="step === (3 + index * 2)"
    
                >
                  <label x-bind:for="'guest_' + index + '_dinner'">
                    <span x-text="guest.fname"></span>'s dinner choice
                  </label>
                  <select
                    x-bind:id="'guest_' + index + '_dinner'"
                    x-bind:name="'guest_' + index + '_dinner'"
                    x-model="guest.dinner"
                    required=""
                  >
                    <option value="">Select an option</option>
                    <option value="Chicken">Chicken</option>
                    <option value="Fish">Fish</option>
                    <option value="Vegetarian">Vegetarian</option>
                    <option value="Vegan">Vegan</option>
                  </select>
                </div>
    
                <div
                  class="form-item field textarea"
                  x-cloak
                  x-transition:enter="transition ease-out duration-300"
                  x-transition:enter-start="opacity-0 scale-90"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-show="step === (3 + index * 2)"
    
                >
                  <label x-bind:for="'guest_' + index + '_allergies'">
                    Does <span x-text="guest.fname"></span> have any food allergies or
                    restrictions?
                  </label>
                  <p class="description">Gluten, Dairy, Shellfish, Peanuts, etc.</p>
                  <textarea
                    x-bind:id="'guest_' + index + '_allergies'"
                    x-bind:name="'guest_' + index + '_allergies'"
                    x-model="guest.allergies"
                  ></textarea>
                </div>
    
                <input
                  type="hidden"
                  x-bind:name="'guest_' + index + '_fname'"
                  x-bind:value="guest ? guest.fname : ''"
                />
                <input
                  type="hidden"
                  x-bind:name="'guest_' + index + '_lname'"
                  x-bind:value="guest ? guest.lname : ''"
                />
              </div>
            </template>
          </div>
        </template>

        <div
          class="form-item field textarea"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === totalSteps"
        >
          <label for="notes"> Questions or Concerns? </label>
          <p class="description">
            Is there anything else you'd like us to know?
          </p>
          <textarea id="notes" name="notes"></textarea>
        </div>
        <div class="flex justify-between align-center">
          <button
            type="button"
            class="button"
            x-on:click.prevent="prevStep()"
            x-show="step > 1"
          >
            Back
          </button>
          <button
            type="button"
            class="button"
            x-on:click.prevent="nextStep()"
            x-show="step < totalSteps && selectedInvite !== null"
          >
            Next
          </button>
          <button type="submit" class="button" x-show="step === totalSteps">
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
