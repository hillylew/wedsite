<template webc:type="11ty" 11ty:type="liquid" webc:if="invites">
	<script webc:keep>
		function filterInvites() {
			return {
        step: 1, 
        totalSteps: 6,
        guest1fname: '',
        guest1lname: '',
        guest1attending: 'No',
        guest2fname: '',
        guest2lname: '',
        guest2attending: 'No',
        showGuest2Fields: 'No',
        allowsGuest2: false,
        hasGuest2: false,
				inviteList: `{{ invites | json }}`,

				init() {
					this.inviteList = JSON.parse(this.inviteList);
				},

				setGuest2FromInvite(invite) {
          if (!invite?.guests?.length) {
            this.allowsGuest2 = false;
            return;
          }

          const matchedGuest = invite.guests.find((guest) => {
            const guestFirstName = (guest.fname || '').trim().toLowerCase();
            const guestLastName = (guest.lname || '').trim().toLowerCase();
            const firstName = (this.guest1fname || '').trim().toLowerCase();
            const lastName = (this.guest1lname || '').trim().toLowerCase();

            const firstNameMatch = !firstName || guestFirstName.includes(firstName);
            const lastNameMatch = !lastName || guestLastName.includes(lastName);

            return firstNameMatch && lastNameMatch;
          });

          const otherGuest = invite.guests.find((guest) => guest !== matchedGuest) || invite.guests[1];

          this.guest2fname = otherGuest?.fname || this.guest2fname;
          this.guest2lname = otherGuest?.lname || this.guest2lname;
          this.hasGuest2 = !!otherGuest;
          this.allowsGuest2 = invite.plusone === true;
          this.showGuest2Fields = invite.guests.length > 1 ? 'Yes' : this.showGuest2Fields;
        },

				get filteredInvites() {
          const firstName = (this.guest1fname || '').trim().toLowerCase();
          const lastName = (this.guest1lname || '').trim().toLowerCase();

          if (!firstName || !lastName) {
            this.allowsGuest2 = false;
            return this.inviteList;
          }


          const matches = this.inviteList.filter((invite) => {
            return invite.guests.some((guest) => {
              const guestFirstName = (guest.fname || '').trim().toLowerCase();
              const guestLastName = (guest.lname || '').trim().toLowerCase();

              const firstNameMatch = !firstName || guestFirstName.includes(firstName);
              const lastNameMatch = !lastName || guestLastName.includes(lastName);

              return firstNameMatch && lastNameMatch;
            });
          });

          if (matches.length) {
            this.setGuest2FromInvite(matches[0]);
          } else {
            this.allowsGuest2 = false;
          }

          return matches;
        },
				nextStep() {
          if (this.guest1attending == 'No' && this.step == 2) {
            this.step = 4;
            return;
          }
          if (this.showGuest2Fields == 'No' && this.step == 4) {
            this.step = 6;
            return;
          }
          if (this.guest2attending == 'No' && this.showGuest2Fields == 'No' && this.step == 4) {
            this.step = 6;
            return;
          }
          if (!this.allowsGuest2 && !this.hasGuest2 && (this.step === 3 || this.step === 4 || this.step === 5)) {
            this.step = 6;
            return;
          }

          this.step++;
        },

				prevStep() {
          if (this.guest1attending == 'No' && this.step == 4) {
            this.step = 2;
            return;
          }
          if (!this.allowsGuest2 && !this.hasGuest2 && (this.step === 4 || this.step === 5 || this.step === 6)) {
            this.step = 3;
            return;
          }
          if (this.showGuest2Fields == 'No' && this.step == 6) {
            this.step = 4;
            return;
          }
          if (this.guest2attending == 'No' && this.showGuest2Fields == 'No' && this.step == 6) {
            this.step = 4;
            return;
          }

          this.step--;
        },
			};
		}
	</script>
</template>

<section class="~py-6/12 first-of-type:~pt-12/24" x-data="filterInvites()">
  <div
    class="container flex justify-between ~gap-8/16"
    :class="alignment == 'right' ? 'flex-col-reverse md:flex-row-reverse' : 'flex-col md:flex-row'"
  >
    <div
      webc:if="image"
      class="md:w-1/2"
      x-data="{ visible: false }"
      x-intersect.threshold.25.once="visible = true"
    >
      <img :src="imageHelper(image.image, 640)" :alt="alt" />
    </div>
    <div
      :class="image ? 'md:w-2/3' : ''"
      x-data="{ visible: false }"
      x-intersect.threshold.25.once="visible = true"
    >
      <div class="progress-bar border border-gray-600 rounded-full flex mb-8">
        <template x-for="s in totalSteps" :key="s">
          <div 
            x-bind:class="{ 'bg-twilight rounded-r-full': s === step, 'bg-twilight': s < step, 'rounded-l-full': s === 1 }"
            class="flex-1 h-6"
          >
            <span class="sr-only" x-text="'Step ' + s">       
            </span>
          </div>
        </template>
      </div>
      <form
        action="/rsvp-submit"
        class="form-contents"
        method="post"
        novalidate=""
      >
        <fieldset class="form-item fields name" 
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === 1"
        >
          <legend>Look up your invitation:</legend>
          <div class="field first-name">
            <label for="guest1fname">
              First Name
            </label>
            <input
              id="guest1fname"
              name="guest1fname"
              x-model="guest1fname" 
              type="text"
              value=""
            />
          </div>
          <div class="field last-name">
            <label for="guest1lname">
              Last Name </label
            ><input
              id="guest1lname"
              name="guest1lname"
              x-model="guest1lname"
              type="text"
              value=""
            />
          </div>
          <div x-show="filteredInvites.length === 1">
            <p x-show="hasGuest2 || allowsGuest2">Welcome! If your invitation includes a guest or your family, you will be able to respond for your entire group.</p>
            <p x-show="!hasGuest2 && !allowsGuest2">Welcome! We were able to locate your invitation.</p>
          </div>
          <div x-show="!filteredInvites.length">
            <p>No matching invites found. Please enter your name exactly as it appears on your invitation.</p>
          </div>
        </fieldset>
        <div class="form-item field radio required" 
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === 2"
        >
          <label for="guest1attending">
            Will you be able to attend?
          </label>
          <div class="form-radio-group">
            <label>
              <input
                type="radio"
                name="guest1attending"
                x-model="guest1attending"
                value="Yes"
                required=""
              />
              Joyfully Accepts
            </label>
            <label>
              <input
                type="radio"
                name="guest1attending"
                value="No"
                required=""
              />
              Sadly Declines
            </label>
          </div>
        </div>
        <div class="form-item field select required" 
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === 3 && guest1attending === 'Yes'"
        >
          <label for="guest1dinner">
            <span x-text="guest1fname"></span>'s dinner choice
          </label>
          <select
            id="guest1dinner"
            name="guest1dinner"
            required=""
          >
            <option value="">Select an option</option>
            <option value="Chicken">Chicken</option>
            <option value="Fish">Fish</option>
            <option value="Vegetarian">Vegetarian</option>
            <option value="Vegan">Vegan</option>  
            <option value="Kid's Meal">Kid's Meal</option>
          </select>
        </div>
        <div
          class="form-item field textarea required" 
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === 3 && guest1attending === 'Yes'"
        >
          <label for="guest1allergies">
            Does <span x-text="guest1fname"></span> have any food allergies or restrictions?
          </label>
          <p class="description">Gluten, Dairy, Shellfish, Peanuts, etc.</p>
          <textarea
            id="guest1allergies"
            name="guest1allergies"
          ></textarea>
        </div>
        <div class="form-item field select required" 
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="!hasGuest2 && allowsGuest2 && step === 4"
        >
          <label for="bringguest">
            Will you be bringing a guest?
          </label>
          <div class="form-radio-group">
            <label>
              <input
                type="radio"
                name="bringguest"
                x-model="showGuest2Fields"
                value="Yes"
                required=""
              />
              Yes
            </label>
            <label>
              <input
                type="radio"
                name="bringguest"
                value="No"
                required=""
              />
              No
            </label>
          </div>
        </div>
        <fieldset
          class="form-item fields name"
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="showGuest2Fields == 'Yes' && !hasGuest2 && allowsGuest2 && step === 4" 
        >
          <legend class="sr-only">Guest 2</legend>
          <div class="field first-name">
            <label for="guest2fname">First Name</label
            ><input
              id="guest2fname"
              name="guest2fname"
              x-model="guest2fname"
              type="text"
              value=""
            />
          </div>
          <div class="field last-name">
            <label for="guest2lname">Last Name</label
            ><input
              id="guest2lname"
              name="guest2lname"
              x-model="guest2lname"
              type="text"
              value=""
            />
          </div>
        </fieldset>
        <div class="form-item field radio required" 
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="showGuest2Fields == 'Yes' && hasGuest2 && step === 4"
        >
          <label for="guest2attending">
            Will <span x-text="guest2fname + ' ' + guest2lname"></span> be able to attend?
          </label>
          <div class="form-radio-group">
            <label>
              <input
                type="radio"
                name="guest2attending"
                x-model="guest2attending"
                value="Yes"
                required=""
              />
              Joyfully Accepts
            </label>
            <label>
              <input
                type="radio"
                name="guest2attending"
                value="No"
                required=""
              />
              Sadly Declines
            </label>
          </div>
        </div>
        <div
          class="form-item field select required"
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="showGuest2Fields == 'Yes' && step === 5"
        >
          <label for="guest2dinner">
            <span x-text="guest2fname"></span>'s dinner choice
          </label>
          <select
            id="guest2dinner"
            name="guest2dinner"
          >
            <option value="">Select an option</option>
            <option value="Chicken">Chicken</option>
            <option value="Fish">Fish</option>
            <option value="Vegetarian">Vegetarian</option>
            <option value="Vegan">Vegan</option>  
            <option value="Kid's Meal">Kid's Meal</option>
          </select>
        </div>
        <div
          class="form-item field textarea required"
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="showGuest2Fields == 'Yes' && step === 5"
        >
          <label for="guest2allergies">
            Does <span x-text="guest2fname"></span> have any food allergies or restrictions?
          </label>
          <p class="description">Gluten, Dairy, Shellfish, Peanuts, etc.</p>
          <textarea 
            id="guest2allergies" 
            name="guest2allergies"
          ></textarea>
        </div>
        <div class="form-item field textarea" 
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-90"
          x-transition:enter-end="opacity-100 scale-100"
          x-show="step === 6"
        >
          <label for="songrequest">
            Got a song request for the DJ?
          </label>
          <p class="description">Let's boogie.</p>
          <textarea
            id="songrequest"
            name="songrequest"
          ></textarea>
        </div>
        <div class="flex justify-between align-center">
          <button type="button" class="button" x-on:click="prevStep()" x-show="step > 1">Back</button>
          <button type="button" class="button" x-on:click="nextStep()" x-show="step < totalSteps && filteredInvites.length === 1">Next</button>
          <button type="submit" class="button" x-show="step === totalSteps">Submit</button>
        </div>
      </form>
    </div>
  </div>
</section>
